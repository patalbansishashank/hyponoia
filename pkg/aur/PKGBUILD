# Maintainer: Shashank <mail@creative.desi>
# `-bin`, not `hyponoia`. The AUR package-naming rules reserve the plain name
# for a package built from source and require the `-bin` suffix on one that
# repackages an upstream binary, which is exactly what this does. It is also
# the name docs/INSTALL.md has always told users to install, and the name a
# from-source `hyponoia` package would have to coexist with.
pkgname=hyponoia-bin
_pkgname=hyponoia
pkgver=0.3.1
pkgrel=1
pkgdesc="Code context engine for AI coding agents — indexes repositories into a queryable graph and returns exact code spans instead of whole files"
arch=('x86_64' 'aarch64')
url="https://github.com/patalbansishashank/hyponoia"
license=('MIT')
# From the shipped ELF's own DT_NEEDED, not from guesswork: libc.so.6 and
# libm.so.6 come from glibc, libstdc++.so.6 and libgcc_s.so.1 from gcc-libs.
# This is the ordinary (dynamic) archive rather than the static `-portable`
# one — Arch's glibc is always newer than the 2.38 floor it was built against,
# and a distribution package is expected to link the system runtime.
depends=('glibc' 'gcc-libs')
provides=("$_pkgname")
conflicts=("$_pkgname")

# The build publishes only the UI variant, so these are the only archives that exist.
source_x86_64=("${pkgname}-${pkgver}-linux-amd64.tar.gz::https://github.com/patalbansishashank/hyponoia/releases/download/v${pkgver}/hyponoia-ui-linux-amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-linux-arm64.tar.gz::https://github.com/patalbansishashank/hyponoia/releases/download/v${pkgver}/hyponoia-ui-linux-arm64.tar.gz")

# v0.3.1's own checksums, copied from the release's checksums.txt and verified
# independently by re-hashing the downloaded archives. They are only ever
# carried forward WITH a matching pkgver: a real hash for the wrong tag fails at
# install time with a mismatch nobody can attribute to a cause, so a version
# bump zeroes these until the new release exists.
sha256sums_x86_64=('c4fa4ef5f62736092695f1c9fcaae23d38d78746e5aa79070e0a07e21c52fa6f')
sha256sums_aarch64=('946d60367968507503cb74531cdc0079b935f81beff5e9a36ce8171e5bfed1ae')

package() {
    install -Dm755 "${srcdir}/hyponoia" \
        "${pkgdir}/usr/bin/hyponoia"
    install -Dm644 "${srcdir}/hyp-integrations.json" \
        "${pkgdir}/usr/share/hyponoia/hyp-integrations.json"
    # Graph UI asset pack. Without it the UI has no assets to serve, so the
    # archive's sixth member cannot be dropped on the floor. The name is the
    # sha256 of the pack's own bytes, so it can only ever be matched by glob.
    # /usr/share/hyponoia is what the runtime resolves as
    # <bindir>/../share/hyponoia/<pack> (src/ui/asset_pack.c) for a /usr/bin
    # binary, and is where this package already puts hyp-integrations.json.
    # Guarded like THIRD_PARTY_NOTICES.md below: archives older than this
    # PKGBUILD predate the pack and must still package.
    for _uipack in "${srcdir}"/hyp-ui-*.pack; do
        [ -f "$_uipack" ] || continue
        install -Dm644 "$_uipack" \
            "${pkgdir}/usr/share/hyponoia/$(basename "$_uipack")"
    done
    install -Dm644 "${srcdir}/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    # Third-party attribution bundle. Guarded: archives older than this
    # PKGBUILD predate it, and the version it first appeared in was upstream's.
    if [ -f "${srcdir}/THIRD_PARTY_NOTICES.md" ]; then
        install -Dm644 "${srcdir}/THIRD_PARTY_NOTICES.md" \
            "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
    fi
}
