    $(HYP_DIR)/service_patterns.c

# LSP resolvers (compiled as one unit via lsp_all.c)
LSP_SRCS = $(HYP_DIR)/lsp_all.c

# Header/source dependencies of the lsp_all unity object. lsp_all.c #includes
# every lsp/*.c resolver, which in turn include hyp.h — and HYPCall is copied
# BY VALUE across the lsp -> pipeline boundary (hyp_calls_push). This object is
# compiled standalone and linked in, NOT recompiled with the rest on every link,
# so it must list the headers/sources it pulls in. Without this, a changed struct
# layout (e.g. a new HYPCall field) leaves a stale lsp_all.o with the old layout —
# an ODR mismatch that under-reads the by-value struct copy. Explicit because this
# Makefile does not use compiler auto-dependency (-MMD) generation.
LSP_UNITY_DEPS = $(HYP_DIR)/lsp_all.c \
                 $(wildcard $(HYP_DIR)/lsp/*.c $(HYP_DIR)/lsp/*.h \
                            $(HYP_DIR)/lsp/generated/*.c $(HYP_DIR)/*.h)

# Tree-sitter runtime
TS_RUNTIME_SRC = $(HYP_DIR)/ts_runtime.c
TS_RUNTIME_DEPS = \
	$(TS_RUNTIME_SRC) \
	$(wildcard $(HYP_DIR)/vendored/ts_runtime/include/tree_sitter/*.h) \
	$(wildcard $(HYP_DIR)/vendored/ts_runtime/src/*.c) \
	$(wildcard $(HYP_DIR)/vendored/ts_runtime/src/*.h) \
	$(wildcard $(HYP_DIR)/vendored/ts_runtime/src/portable/*.h) \
	$(wildcard $(HYP_DIR)/vendored/ts_runtime/src/unicode/*.h)

# All 159 grammar shim files
GRAMMAR_SRCS = $(wildcard $(HYP_DIR)/grammar_*.c)

# LZ4 + Aho-Corasick
AC_LZ4_SRCS = $(HYP_DIR)/ac.c $(HYP_DIR)/lz4_store.c

# Zstd compression (for persistent artifacts)
ZSTD_SRCS = $(HYP_DIR)/zstd_store.c

# Preprocessor (C++)
PREPROCESSOR_SRC = $(HYP_DIR)/preprocessor.cpp

# SQLite writer
SQLITE_WRITER_SRC = $(HYP_DIR)/sqlite_writer.c

# Store module (new)
# ask_index.c is the READ half of the `ask` lane's opt-in vector store
