# Memory module (§4 Track C): anchor resolution against the live index.
MEMORY_SRCS = src/memory/anchor.c

# SimHash / MinHash module
SIMHASH_SRCS = src/simhash/minhash.c

# Semantic embedding module
# ask_embed.c is the inference boundary for the `ask` lane; ask_lang.c decides
# which language's instruct prefix is rendered and ask_prefix.c renders it.
# None of the three is read by the static token-vector path.
SEMANTIC_SRCS = src/semantic/semantic.c src/semantic/ast_profile.c src/semantic/rotsq.c \
    src/semantic/ask_embed.c src/semantic/ask_lang.c src/semantic/ask_prefix.c

# `ask` lane (NEXT-STEPS §2.1): per-declaration transformer vectors, their own
# SQLite file, and the opt-in second pass that fills it. Deliberately its own
# module and its own subcommand — nothing here runs during index_repository, so
# the structural index keeps exactly the speed it has.
ASK_SRCS = src/ask/ask_batch.c src/ask/ask_encoder.c src/ask/ask_vectors.c \
           src/ask/ask_embed.c src/ask/ask_cmd.c src/ask/ask_llama.c \
