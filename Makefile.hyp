    $(HYP_DIR)/hyp.c \
    $(HYP_DIR)/extract_defs.c \
    $(HYP_DIR)/extract_calls.c \
    $(HYP_DIR)/extract_imports.c \
    $(HYP_DIR)/extract_usages.c \
    $(HYP_DIR)/extract_unified.c \
    $(HYP_DIR)/extract_semantic.c \
