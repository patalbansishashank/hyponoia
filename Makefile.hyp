    src/ui/http_server.c \
    src/ui/layout3d.c \
    src/ui/httpd.c \
    src/ui/asset_pack_stub.c

# mimalloc (vendored, global allocator override)
#
# Override strategy is platform-specific:
#  * Unix (macOS/Linux): rely on static-link-order override — the prod mimalloc
#    object is linked first so its strong malloc/free symbols win. We do NOT
#    define MI_MALLOC_OVERRIDE here: that would compile alloc-override.c's
#    forwarding definitions (malloc/free/posix_memalign/...) which, on macOS's
#    two-level namespace, makes the binary's free == mi_free while system
#    libraries keep allocating via the system allocator — pointers crossing that
#    boundary hit "mimalloc: error: mi_free: invalid pointer". (Repro:
#    `hyponoia index <dir>` aborted on every run.)
#  * Windows (MinGW, static CRT): the link-order trick fails (#424's allocator
#    mismatch), so we define MI_MALLOC_OVERRIDE=1 to compile the static-CRT
#    override added in mimalloc 3.3.0 (the _MSC_VER / _ACRTIMP /
#    _CRT_HYBRIDPATCHABLE entry points) which take precedence over the static
#    CRT's malloc/free.
# Note: mimalloc's source gates the override body on MI_MALLOC_OVERRIDE (CMake
# derives it from the MI_OVERRIDE option); MI_OVERRIDE alone is not read by the
# source — it is kept here only as this project's prod/test marker.
MIMALLOC_SRC = vendored/mimalloc/src/static.c
# Linux belongs on this list too (#1360). The "Unix relies on static-link-order
# override" strategy described above never actually worked: mimalloc defines
# malloc/free ONLY when MI_MALLOC_OVERRIDE is set (it gates alloc-override.c),
# so with the define off there were no strong symbols for the link order to
# prefer. Measured on the shipped v0.9.1-rc.1 artifacts — linux-arm64 glibc AND
# musl-static both report 0/6 allocator-owned size classes, i.e. ordinary malloc
# was going to libc and every purge/reclaim option set in hyp_mem_init applied
# only to the bound sqlite/tree-sitter populations.
#
# The macOS objection does not transfer. That abort is specific to the two-level
# namespace, where this binary's free becomes mi_free while system libraries keep
# allocating from the system allocator, so a pointer crossing the boundary hits
# "mi_free: invalid pointer". ELF is a flat namespace: interposition is
# process-wide and all-or-nothing, which is the configuration mimalloc is
# normally deployed in. macOS therefore stays off, deliberately and permanently.
#
# TWO defines, switched together in ONE place so they cannot drift:
# MI_MALLOC_OVERRIDE reaches the mimalloc translation unit and turns the
# override on; HYP_MEM_GLOBAL_OVERRIDE reaches OUR sources and tells the startup
# audit what to expect. HYP_MEM_GLOBAL_OVERRIDE goes only into CFLAGS_PROD,
# because MIMALLOC_CFLAGS_TEST compiles mimalloc with -DMI_OVERRIDE=0 and no
# override define at all — a test binary has no global override BY CONSTRUCTION
# and must never be told to expect one, or it warns on every run.
MIMALLOC_OVERRIDE_DEFINE :=
GLOBAL_OVERRIDE_DEFINE :=
ifneq ($(filter yes,$(IS_MINGW) $(IS_LINUX)),)
MIMALLOC_OVERRIDE_DEFINE := -DMI_MALLOC_OVERRIDE=1
GLOBAL_OVERRIDE_DEFINE := -DHYP_MEM_GLOBAL_OVERRIDE=1
endif
MIMALLOC_CFLAGS = -std=c11 -O2 -w \
                  -Ivendored/mimalloc/include \
                  -Ivendored/mimalloc/src \
                  -DMI_OVERRIDE=1 \
                  $(MIMALLOC_OVERRIDE_DEFINE)
MIMALLOC_CFLAGS_TEST = -std=c11 -g -O1 -w \
                       -Ivendored/mimalloc/include \
                       -Ivendored/mimalloc/src \
                       -DMI_OVERRIDE=0

# sqlite3 (vendored amalgamation — compiled ourselves for ASan instrumentation)
# SQLITE_ENABLE_FTS5: enables the FTS5 full-text search extension used by the
# BM25 search path in search_graph (see nodes_fts virtual table in store.c).
#
# SQLITE_OMIT_LOAD_EXTENSION: no hyp code calls sqlite3_load_extension or
# sqlite3_enable_load_extension, and we never want a graph DB to be able to pull
# a shared library into the process. Loading is off by default at runtime, but
# "disabled by default" is a setting while "not compiled in" is a property —
# this compiles the machinery out, removing the API surface and part of the
# dlopen/dlsym import surface with it. The composition gate asserts the symbols
# are absent from every release artifact.
SQLITE3_OMIT_FLAGS = -DSQLITE_OMIT_LOAD_EXTENSION
SQLITE3_SRC = vendored/sqlite3/sqlite3.c
SQLITE3_CFLAGS = -std=c11 -O2 -w -DSQLITE_DQS=0 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5 \
                 $(SQLITE3_OMIT_FLAGS)
SQLITE3_CFLAGS_TEST = -std=c11 -g -O1 -w -DSQLITE_DQS=0 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5 \
                      $(SQLITE3_OMIT_FLAGS)

# TRE regex (vendored, Windows only — POSIX uses system <regex.h>)
TRE_SRC = vendored/tre/tre_all.c
TRE_CFLAGS = -std=c11 -g -O1 -w -Ivendored/tre

# yyjson (vendored)
YYJSON_SRC = vendored/yyjson/yyjson.c

# ── llama.cpp: the `ask` lane's in-process encoder ────────────────
#
# NEXT-STEPS.md §2.1 runs a whole declaration through Qwen3-Embedding-0.6B
# instead of adding up per-token vectors. runs/ASK/T2-inference-runtime.json
# settled the runtime with a working prototype. See vendored/llama.cpp/NOTICE
# for what was taken and HYPONOIA-PATCHES.md for the twelve lines that differ
# from upstream.
#
# HYP_ASK_GPU decides the DEVICE the lane can use, and it is a deliberate,
# stated build configuration rather than a detection:
#
#   vulkan  (default)  the Vulkan backend is compiled in. 15.2x on the one
#                      operation that takes minutes (24.09 vs 1.581 docs/s,
#                      ~3 min vs ~43 min for lld/ELF). COSTS: ~+51 MB of
#                      embedded SPIR-V, a RUNTIME dependency on libvulkan.so.1,
#                      and therefore STATIC=1 — see the refusal below. Needs
#                      glslc and Vulkan-Headers at build time.
#   none               CPU only. Keeps STATIC=1 and the one-file install story.
#                      The `ask` lane still works; it is 15x slower to index.
#
# There is no third value and no auto-detect. A build that quietly dropped to
# CPU because glslc was missing would ship a binary that takes 43 minutes where
# the operator expected 3, and nothing on the box would say why. Track 4's
# device plumbing separates the REQUEST from the OUTCOME for the same reason at
# runtime; this is the build-time half of it. (HYP_ASK_GPU itself is declared
# near STATIC_FLAGS above, which has to be able to refuse it.)

LLAMA_DIR = vendored/llama.cpp

# The `ask` lane's llama.cpp objects are PRODUCTION-ONLY. The test suites drive
# the encoder seam through hyp_ask_encoder_stub_create (deliberate: 25 of the
# ask tests must run with no model on disk), so linking 171 translation units
# of C++ into the ASan test-runner would buy nothing and cost minutes per run.
LLAMA_GGML_BASE_SRCS = \
    $(LLAMA_DIR)/ggml/src/ggml.c \
    $(LLAMA_DIR)/ggml/src/ggml.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-alloc.c \
    $(LLAMA_DIR)/ggml/src/ggml-backend.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-backend-meta.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-opt.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-threading.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-quants.c \
    $(LLAMA_DIR)/ggml/src/gguf.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-backend-dl.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-backend-reg.cpp

# The CPU backend's SIMD kernels are selected per host architecture, the way
# ggml's own build does. Everything else in ggml-cpu is architecture-neutral.
LLAMA_UNAME_M := $(shell uname -m 2>/dev/null)
ifneq (,$(filter x86_64 amd64 i386 i686,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/x86
else ifneq (,$(filter aarch64 arm64 armv7l,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/arm
else ifneq (,$(filter ppc64le ppc64,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/powerpc
else ifneq (,$(filter riscv64,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/riscv
else ifneq (,$(filter s390x,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/s390
else ifneq (,$(filter loongarch64,$(LLAMA_UNAME_M)))
LLAMA_CPU_ARCH_DIR = arch/loongarch
else
LLAMA_CPU_ARCH_DIR = arch/x86
endif

LLAMA_GGML_CPU_SRCS = \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/ggml-cpu.c \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/ggml-cpu.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/repack.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/hbm.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/quants.c \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/traits.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/amx/amx.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/amx/mmq.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/binary-ops.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/unary-ops.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/vec.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/ops.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/llamafile/sgemm.cpp \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/$(LLAMA_CPU_ARCH_DIR)/quants.c \
    $(LLAMA_DIR)/ggml/src/ggml-cpu/$(LLAMA_CPU_ARCH_DIR)/repack.cpp

LLAMA_LIB_SRCS = $(sort $(wildcard $(LLAMA_DIR)/src/*.cpp) \
                        $(wildcard $(LLAMA_DIR)/src/models/*.cpp))

# ggml's own CMake compiles the CPU backend with -march=native. We do NOT:
# a shipped binary that faults with SIGILL on a machine one generation older
# than the build host is not a portable binary, and this project ships one
# artifact per platform. Set HYP_LLAMA_ARCHFLAGS=-march=native to get ggml's
# posture back on a machine that is only ever going to run its own build.
HYP_LLAMA_ARCHFLAGS ?=

# GGML_VERSION/GGML_COMMIT are pinned STRINGS, not a git call: __DATE__-style
# build-time entropy is exactly what the mimalloc patch exists to remove, and a
# `git describe` in a compile line is the same class of thing.
LLAMA_VERSION_DEFINES = -DGGML_VERSION=\"0.19.0-hyp\" \
                        -DGGML_COMMIT=\"74ce157\"

LLAMA_INCLUDES = -I$(LLAMA_DIR)/ggml/include -I$(LLAMA_DIR)/ggml/src \
                 -I$(LLAMA_DIR)/ggml/src/ggml-cpu -I$(LLAMA_DIR)/include \
                 -I$(LLAMA_DIR)/src
LLAMA_DEFINES = -DNDEBUG -D_GNU_SOURCE -D_XOPEN_SOURCE=600 \
                -DGGML_SCHED_MAX_COPIES=4 -DGGML_USE_CPU \
                -DGGML_USE_CPU_REPACK -DGGML_USE_LLAMAFILE \
                $(LLAMA_VERSION_DEFINES)

# THE SECOND FLAGS BUCKET. llama.cpp requires C++17 and says so emphatically
# (`target_compile_features(llama PRIVATE cxx_std_17) # don't bump`).
# CXXFLAGS_COMMON is -std=c++14 for the tree-sitter preprocessor and cannot be
# reused. Warnings are relaxed with -w the way vendored/sqlite3 and the
# grammars already are — llama.cpp's C++ does not survive -Wall -Wextra
# -Werror, and editing third-party code to satisfy our flags would make every
# upstream sync a merge conflict. -Werror still covers all of src/.
LLAMA_CFLAGS   = -std=c11   -O2 -w -fPIC $(HYP_LLAMA_ARCHFLAGS) $(LLAMA_INCLUDES) $(LLAMA_DEFINES)
LLAMA_CXXFLAGS = -std=c++17 -O2 -w -fPIC $(HYP_LLAMA_ARCHFLAGS) $(LLAMA_INCLUDES) $(LLAMA_DEFINES)

LLAMA_LINK_LIBS =
LLAMA_SHADER_DIR =

ifeq ($(HYP_ASK_GPU),vulkan)
# Vulkan-Headers and SPIRV-Headers are BUILD-time dependencies like a compiler,
# not code we ship, so they are not vendored. Resolution order, per header set:
#   1. an explicit VULKAN_INCLUDE= / SPIRV_INCLUDE= on the make command line;
#   2. the system include root when the distro packages are installed
#      (Debian/Ubuntu: libvulkan-dev -> /usr/include/vulkan/vulkan.h,
#       spirv-headers -> /usr/include/spirv/unified1/spirv.hpp — what the CI
#       build-linux-gpu job installs);
#   3. the developer-cache checkout that the original T2 measurement used.
# The probe is on the one file each header set is included for, so a partial
# install (vulkan.h without vulkan.hpp, say) still fails at the compile of
# ggml-vulkan.cpp with the real missing-header name rather than a stale path.
HYP_SYS_INCLUDE ?= /usr/include
ifneq (,$(wildcard $(HYP_SYS_INCLUDE)/vulkan/vulkan.h))
VULKAN_INCLUDE ?= $(HYP_SYS_INCLUDE)
else
VULKAN_INCLUDE ?= $(HOME)/.cache/hyp-t2/Vulkan-Headers/include
endif
# ggml-vulkan.cpp includes <spirv/unified1/spirv.hpp> to name SPIR-V capabilities.
ifneq (,$(wildcard $(HYP_SYS_INCLUDE)/spirv/unified1/spirv.hpp))
SPIRV_INCLUDE ?= $(HYP_SYS_INCLUDE)
else
SPIRV_INCLUDE ?= $(HOME)/.cache/hyp-t2/spirv-install/include
endif
GLSLC ?= glslc
LLAMA_GGML_VK_SRC = $(LLAMA_DIR)/ggml/src/ggml-vulkan/ggml-vulkan.cpp
LLAMA_VK_SHADER_SRC = $(LLAMA_DIR)/ggml/src/ggml-vulkan/vulkan-shaders
LLAMA_SHADER_DIR = $(BUILD_DIR)/vulkan-shaders
LLAMA_VK_FEATURES := $(shell scripts/gen-vulkan-shaders.sh --features \
    $(LLAMA_DIR)/ggml/src/ggml-vulkan/vulkan-shaders "$(GLSLC)" \
    build/c/glslc-features 2>/dev/null)
LLAMA_DEFINES += -DGGML_USE_VULKAN
LLAMA_LINK_LIBS += -lvulkan
LLAMA_VK_CXXFLAGS = $(LLAMA_CXXFLAGS) $(LLAMA_VK_FEATURES) \
                    -I$(VULKAN_INCLUDE) -I$(SPIRV_INCLUDE) -I$(LLAMA_SHADER_DIR)
endif

LLAMA_ALL_SRCS = $(LLAMA_GGML_BASE_SRCS) $(LLAMA_GGML_CPU_SRCS) $(LLAMA_LIB_SRCS)
LLAMA_OBJ_DIR = $(BUILD_DIR)/llama
LLAMA_OBJS = $(patsubst $(LLAMA_DIR)/%,$(LLAMA_OBJ_DIR)/%.o,$(LLAMA_ALL_SRCS))


# All production sources
PROD_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) $(DAEMON_SRCS) $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(MEMORY_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) $(ASK_SRCS) $(TRACES_SRCS) $(WATCHER_SRCS) $(GIT_SRCS) $(CLI_SRCS) $(UI_SRCS) $(YYJSON_SRC)
PROD_SRCS = $(FOUNDATION_SRCS) $(STORE_SRCS) $(CYPHER_SRCS) $(MCP_SRCS) $(DAEMON_SRCS) $(DISCOVER_SRCS) $(GRAPH_BUFFER_SRCS) $(PIPELINE_SRCS) $(SIMHASH_SRCS) $(SEMANTIC_SRCS) $(ASK_SRCS) $(TRACES_SRCS) $(WATCHER_SRCS) $(INGEST_SRCS) $(GIT_SRCS) $(CLI_SRCS) $(UI_SRCS) $(YYJSON_SRC)
TEST_PROD_SRCS = $(subst src/ui/asset_pack_stub.c,src/ui/asset_pack.c src/ui/asset_manifest_stub.c,$(PROD_SRCS))
EXISTING_C_SRCS = $(EXTRACTION_SRCS) $(LSP_SRCS) $(TS_RUNTIME_SRC) \
                  $(GRAMMAR_SRCS) $(AC_LZ4_SRCS) $(ZSTD_SRCS) $(SQLITE_WRITER_SRC)

# Project headers, as prerequisites for the targets built in one compiler
# invocation from sources (test-runner, test-repro-runner, test-runner-tsan,
# hyponoia, test-foundation). Those rules list only .c files, so
# editing a header changed nothing make could see and the target was NOT
# rebuilt — an incremental build then silently tested the OLD header value.
# Found while revert-checking a constants.h change: the check passed because
# nothing had recompiled.
#
# Vendored trees are deliberately excluded — they are pinned, they carry their
# own explicit dep lists (LSP_UNITY_DEPS, TS_RUNTIME_DEPS), and globbing tens of
# thousands of grammar headers would cost more than it protects.
PROJECT_HDRS = $(wildcard src/*.h src/*/*.h $(HYP_DIR)/*.h $(HYP_DIR)/lsp/*.h tests/*.h \
               tests/repro/*.h)

# ── Integration-asset integrity constant (generated, never hand-edited) ──
# The binary embeds exactly ONE fact about the shipped integration templates:
# the SHA-256 of assets/hyp-integrations.json, generated at build time (rule
# below the BUILD_DIR definition; target lines expand immediately). Appended
# to PROJECT_HDRS so every single-invocation target (test-runner,
# test-repro-runner, test-runner-tsan, hyponoia) rebuilds when the
# asset changes — a stale constant would make every install fail verification.
INTEGRATIONS_ASSET = assets/hyp-integrations.json
INTEGRATIONS_HASH_HDR = $(BUILD_DIR)/generated/hyp_integrations_hash.h
PROJECT_HDRS += $(INTEGRATIONS_HASH_HDR)

# ── Test sources ─────────────────────────────────────────────────

# Foundation suites, WITHOUT an entry point. Two binaries link them: the full
# test-runner (tests/test_main.c) and the foundation-only test-foundation
# (tests/test_foundation_main.c). Keeping the suite list separate from the main
# is what lets the small target exist at all — test_main.c hard-references every
# suite in the tree, so it can only ever live in the full link.
TEST_FOUNDATION_SUITE_SRCS = \
    tests/test_arena.c \
    tests/test_hash_table.c \
    tests/test_dyn_array.c \
    tests/test_str_intern.c \
    tests/test_record.c \
    tests/test_scrub.c \
    tests/test_log.c \
    tests/test_str_util.c \
    tests/test_workspace.c \
    tests/test_platform.c \
    tests/test_diagnostics.c \
    tests/test_dump_verify.c \
    tests/test_subprocess.c \
    tests/test_private_file_lock.c \
    tests/test_lock_registry.c

TEST_FOUNDATION_SRCS = tests/test_main.c $(TEST_FOUNDATION_SUITE_SRCS)

TEST_FOUNDATION_ONLY_SRCS = tests/test_foundation_main.c $(TEST_FOUNDATION_SUITE_SRCS)

TEST_EXTRACTION_SRCS = \
    tests/test_extraction.c \
    tests/test_extraction_inheritance.c \
    tests/test_extraction_imports.c \
    tests/test_parse_coverage.c \
    tests/test_grammar_regression.c \
    tests/test_grammar_labels.c \
    tests/test_grammar_imports.c \
    tests/test_ac.c

TEST_STORE_SRCS = \
    tests/test_store_nodes.c \
    tests/test_store_edges.c \
    tests/test_store_search.c \
    tests/test_store_arch.c \
    tests/test_store_bulk.c \
    tests/test_store_pragmas.c \
    tests/test_store_checkpoint.c \
    tests/test_record_store.c \
    tests/test_dump_verify_io.c

TEST_CYPHER_SRCS = \
    tests/test_cypher.c

TEST_MCP_SRCS = \
    tests/test_mcp.c \
    tests/test_index_supervisor.c

TEST_DAEMON_SRCS = \
    tests/test_daemon.c \
    tests/test_project_lock.c \
    tests/test_version_cohort.c \
    tests/test_daemon_version.c \
    tests/test_daemon_runtime.c \
    tests/test_daemon_application.c \
    tests/test_daemon_frontend.c \
    tests/test_daemon_bootstrap.c \
    tests/test_daemon_ipc.c

TEST_DISCOVER_SRCS = \
    tests/test_language.c \
    tests/test_userconfig.c \
    tests/test_gitignore.c \
    tests/test_git_context.c \
    tests/test_roles.c \
    tests/test_discover.c

TEST_GRAPH_BUFFER_SRCS = tests/test_graph_buffer.c

TEST_PIPELINE_SRCS = tests/test_registry.c tests/test_pipeline.c tests/test_cross_repo.c tests/test_fqn.c tests/test_identity.c tests/test_route_canon.c tests/test_path_alias.c tests/test_configlink.c tests/test_infrascan.c tests/test_worker_pool.c tests/test_parallel.c tests/test_index_resilience.c tests/test_call_reference_contract.c tests/repro/repro_call_scope_usages.c tests/repro/repro_call_argument_usages.c tests/repro/repro_reference_precision.c tests/repro/repro_lexical_binding_precision.c tests/repro/repro_call_argument_matrix_a.c tests/repro/repro_call_argument_matrix_b.c tests/repro/repro_call_node_behaviors.c tests/repro/repro_language_registry.c tests/repro/repro_call_node_manifest.c tests/repro/repro_lsp_ordered_signatures.c tests/repro/repro_lsp_ordered_local.c tests/repro/repro_ts_overload_return_chains.c tests/repro/repro_harness_cleanup.c tests/repro/repro_runner_filter.c

TEST_MEMORY_SRCS = tests/test_anchor.c

TEST_WATCHER_SRCS = tests/test_watcher.c

TEST_INGEST_SRCS = tests/test_watched_ingest.c

TEST_LZ4_SRCS = tests/test_lz4.c
TEST_ZSTD_SRCS = tests/test_zstd.c
TEST_ARTIFACT_SRCS = tests/test_artifact.c

TEST_SQLITE_WRITER_SRCS = tests/test_sqlite_writer.c

TEST_GO_LSP_SRCS = tests/test_go_lsp.c

TEST_C_LSP_SRCS = tests/test_c_lsp.c

