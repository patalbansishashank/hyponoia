static bool check_inline_props(const cbm_node_t *n, const cbm_prop_filter_t *props, int count) {
    for (int i = 0; i < count; i++) {
        const char *actual = node_prop(n, props[i].key);
        if (strcmp(actual, props[i].value) != 0) {
            return false;
        }
    }
    return true;
}