#!/usr/bin/env bash
# Refuse to push a commit carrying a vendor API key, or code that fails a gate.
# NEXT-STEPS.md §2.13 (secrets).
#
# pre-push, not pre-commit, deliberately: a key in a local commit is a mistake,
# a key in a pushed commit is an incident. This is the last point at which it is
# still only the former.
#
# THERE IS NO CI BEHIND THIS HOOK ANY MORE. The workflows are deleted and
# GitHub Actions is off for this repository, by the owner's instruction. Every
# sentence below that used to end "and CI will catch it" now ends here instead,
# so the hook runs the Step-0 contract set as well as format and secrets --
# scripts/gate.sh --fast, which is the same set by construction rather than a
# second list. It is still seconds, because Step 0 runs before any compiler.
#
# What this hook deliberately does NOT run is cppcheck (~10 min) and the suite
# (hours). That is not an oversight and not a gap left to CI: a ten-minute hook
# gets exported around rather than run, which is worse than a fast one that is
# always honoured. Those are `gate.sh --full` before a merge and `gate.sh --all`
# before a release, and they are a human's call, not a push's.
#
# stdin carries "<local ref> <local sha> <remote ref> <remote sha>" per ref, so
# the scan sees exactly the commits this push would publish. It walks those
# COMMITS, not the worktree — the key that made this necessary had already been
# removed from the worktree and was still in every clone. stdin is therefore
# reserved for the scan; lint runs first and must not consume it.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

# git exports GIT_DIR, GIT_INDEX_FILE and friends into every hook, and they are
# INHERITED by everything the hook runs. Several contract tests build a throwaway
# repository in a temp directory and commit into it; with GIT_DIR still pointing
# at this repository those commits target the wrong git dir and the test fails
# for a reason that has nothing to do with the tree being pushed.
#
# Found the first time this hook ran the contract set: the comment-lint contract
# passed standalone and failed under the hook, reporting a missing dco-signed.sh
# inside /tmp. Unset them here, once, rather than teaching each test to defend
# itself -- the leak has one source and this is it. The push range on stdin is
# unaffected: it is data on a pipe, not environment.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_OBJECT_DIRECTORY
unset GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_QUARANTINE_PATH
SCAN="$ROOT/scripts/check-secret-history.sh"
LINT_IMAGE="hyp-lint"
LINT_DOCKERFILE="$ROOT/test-infrastructure/Dockerfile.lint"

# ── Deleting a ref publishes nothing ─────────────────────────────────────
#
# `git push --delete <branch>` sends an all-zero LOCAL sha for that ref. There
# is no commit being published, so there is no tree to format-check and no
# history to scan: gating it costs minutes to verify a claim about content that
# does not exist, and the failure mode is worse than the cost -- a hook that
# refuses a deletion makes branch cleanup impossible without exporting around
# the hook, which is how a hook stops being run at all.
#
# stdin is read ONCE, here, and replayed to the scan below, because it is a pipe
# and a second read would get nothing. Only a push where EVERY ref is a deletion
# is skipped; a mixed push still runs the whole gate on what it publishes.
REFS="$(cat)"
all_deletions=1
have_refs=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    have_refs=1
    case "$local_sha" in
        *[!0]*) all_deletions=0 ;;
    esac
done <<EOF
$REFS
EOF
if [ "$have_refs" -eq 1 ] && [ "$all_deletions" -eq 1 ]; then
    echo "pre-push: deletion only, nothing is being published — gate skipped." >&2
    exit 0
fi

# ── Formatting, in CI's environment ──────────────────────────────────────
#
# `lint-format` ONLY, deliberately — not the whole lint job. Measured: the full
# gate is 586-667s in CI and ~10 min here, essentially all of it cppcheck, while
# clang-format alone is 4.5s. A ten-minute pre-push hook does not get run, it
# gets exported around, so cppcheck stays in CI where its cost is already paid.
#
# Formatting is also the half that fails for a reason CI alone can never teach
# you in less than an hour: CI pins clang-format 20, a workstation typically has
# a newer major, and the two disagree on code neither considers wrong. Checking
# with the wrong version is worse than not checking — it reports green while CI
# reports red. The image is the only thing that reproduces the pinned version.
if [ "${HYP_SKIP_PREPUSH_LINT:-}" = "1" ]; then
    echo "pre-push: gate skipped (HYP_SKIP_PREPUSH_LINT=1). Nothing else will check this." >&2
elif ! command -v docker >/dev/null 2>&1; then
    echo "pre-push: docker not found, so the pinned clang-format cannot be reproduced here." >&2
    echo "  This machine's clang-format is a different major and rewrites code the pinned" >&2
    echo "  one accepts, so checking with it reports green on code that is not." >&2
    echo "  Install docker, or push with HYP_SKIP_PREPUSH_LINT=1 and nothing checks it." >&2
    exit 1
elif ! bash "$ROOT/scripts/gate.sh" --fast >&2; then
    echo "" >&2
    echo "pre-push: GATE FAILED — refusing the push." >&2
    echo "  Reformat in place:  docker run --rm --user \"\$(id -u):\$(id -g)\" -v \"\$PWD\":/src \\" >&2
    echo "                        --entrypoint make $LINT_IMAGE -f Makefile.hyp format \\" >&2
    echo "                        CLANG_FORMAT=clang-format-20" >&2
    exit 1
fi

# ── Secrets ──────────────────────────────────────────────────────────────
if [ ! -x "$SCAN" ]; then
    echo "pre-push: $SCAN missing or not executable — cannot verify, refusing." >&2
    exit 1
fi

exec "$SCAN" <<EOF
$REFS
EOF
